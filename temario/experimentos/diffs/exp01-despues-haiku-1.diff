+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Descarta las ventas con importe exactamente cero.
+
+    Una venta sin importe no es una venta válida: no representa un ingreso ni
+    una devolución real. Se descarta y queda contada.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"""
+        CREATE OR REPLACE TABLE {destino} AS
+        SELECT * FROM {origen}
+        WHERE importe != 0
+        """
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe es cero",
+    )
+
+
