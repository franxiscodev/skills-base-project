+def test_descartar_importe_cero_elimina_ventas_sin_importe(con, tabla_cruda):
+    """Una venta con importe cero no es una transacción válida."""
+    origen = tabla_cruda([VENTA, ("2", "15/03/2026", "Madrid", "Teclado", "1", "0.00")])
+    limpiar.normalizar_texto(con, origen, "texto")
+    limpiar.convertir_tipos(con, "texto", "tipos")
+
+    recuento = limpiar.descartar_importe_cero(con, "tipos", "salida")
+
+    assert recuento.entrantes == 2
+    assert recuento.salientes == 1
+    assert recuento.descartadas == 1
+
+
+def test_descartar_importe_cero_no_toca_importes_positivos_ni_negativos(con, tabla_cruda):
+    """Devoluciones y ventas válidas tienen importe distinto de cero."""
+    origen = tabla_cruda(
+        [
+            ("1", "15/03/2026", "Madrid", "Teclado", "2", "59.80"),
+            ("2", "15/03/2026", "Madrid", "Ratón", "-1", "-15.50"),
+        ]
+    )
+    limpiar.normalizar_texto(con, origen, "texto")
+    limpiar.convertir_tipos(con, "texto", "tipos")
+
+    recuento = limpiar.descartar_importe_cero(con, "tipos", "salida")
+
+    assert recuento.descartadas == 0
+    assert recuento.salientes == 2
+
