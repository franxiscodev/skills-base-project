+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Elimina las ventas cuyo importe es exactamente cero.
+
+    Una fila con importe 0 no aporta nada al total y sí distorsiona todo lo que se
+    calcula por venta —número de operaciones, importe medio, ranking de productos—.
+    Suelen ser líneas técnicas del sistema de origen: anulaciones, regalos o
+    cabeceras de pedido que se exportan como si fueran una venta más.
+
+    Dos límites deliberados, porque `= 0` no es lo mismo que "poco":
+
+    - **Un importe pequeño se queda.** 0,01 € es una venta con un importe raro, no
+      una no-venta. Solo el cero exacto es señal de que ahí no hubo operación.
+    - **Un importe negativo se queda.** Es el terreno de `marcar_devoluciones`, que
+      clasifica en vez de borrar; descartarlo aquí escondería una devolución real.
+
+    Va después de `convertir_tipos` por necesidad: hasta ahí el importe es texto, y
+    `"0,00"`, `"0.00"` y `"0"` son cadenas distintas que valen lo mismo.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"CREATE OR REPLACE TABLE {destino} AS SELECT * FROM {origen} WHERE importe <> 0"
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe exactamente cero: no es una venta",
+    )
+
+
