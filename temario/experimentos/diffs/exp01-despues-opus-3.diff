+def test_descartar_importe_cero_respeta_lo_que_no_es_cero(con, tabla_cruda):
+    """El criterio es el cero exacto, no "importe pequeño" ni "importe raro".
+
+    Un céntimo es una venta con un importe extraño; una devolución con importe
+    negativo la clasifica `marcar_devoluciones`. Si mañana esta regla se convierte
+    en `importe <= 0` o en un umbral mínimo, este test lo dice.
+    """
+    origen = tabla_cruda(
+        [
+            ("1", "15/03/2026", "Madrid", "Teclado", "1", "0.01"),
+            ("2", "15/03/2026", "Madrid", "Teclado", "-1", "-29.90"),
+        ]
+    )
+    limpiar.convertir_tipos(con, origen, "tipos")
+
+    recuento = limpiar.descartar_importe_cero(con, "tipos", "salida")
+
+    assert recuento.descartadas == 0
+    importes = con.sql("SELECT importe FROM salida ORDER BY id_venta").fetchall()
+    assert importes == [(0.01,), (-29.90,)]
+
