+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Elimina las ventas cuyo importe es exactamente cero.
+
+    Un importe a cero no es una venta: en el origen aparece por líneas de prueba,
+    regalos y anulaciones que el sistema deja registradas. No aportan facturación y
+    sí ensucian el desglose por producto y ciudad, donde cuentan como una operación
+    más con ingreso nulo.
+
+    Se compara **después** de `convertir_tipos`: hasta ese punto el importe es texto
+    y `"0,00"`, `"0"` y `"0.0"` son cadenas distintas que representan el mismo cero.
+
+    Y solo se descarta el cero exacto. Los importes negativos se quedan: son el
+    contrapunto de las devoluciones que marca `marcar_devoluciones`, y eliminarlos
+    aquí inflaría el neto por la puerta de atrás.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"CREATE OR REPLACE TABLE {destino} AS SELECT * FROM {origen} WHERE importe <> 0"
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe cero: no es una venta",
+    )
+
+
