+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Descarta las ventas con importe cero, que no tienen valor económico.
+
+    Una venta sin importe (cero) no contribuye a la facturación ni a ningun análisis
+    económico. Se descarta por ser un artefacto de los datos, no un hecho real de
+    negocio.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"""
+        CREATE OR REPLACE TABLE {destino} AS
+        SELECT * FROM {origen}
+        WHERE importe != 0
+        """
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe cero",
+    )
+
+
