+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Elimina las ventas cuyo importe es exactamente cero.
+
+    El criterio: **una venta de cero euros no es una venta.** Suele ser una línea
+    técnica del sistema de origen —un ajuste, una corrección que se anula sola, un
+    alta que nunca se facturó— y dejarla dentro no cambia el total pero sí infla el
+    recuento de operaciones, que es justo lo que se mira para calcular el ticket
+    medio.
+
+    Solo el cero. Un importe negativo se conserva: eso sí es un hecho de negocio,
+    y de él se ocupa `marcar_devoluciones`.
+
+    Va después de `convertir_tipos` porque hasta ese paso `importe` es texto, y
+    `"0,00"`, `"0"` y `"0.00"` son tres cadenas distintas que valen lo mismo.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"CREATE OR REPLACE TABLE {destino} AS SELECT * FROM {origen} WHERE importe <> 0"
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe cero: no es una venta",
+    )
+
+
