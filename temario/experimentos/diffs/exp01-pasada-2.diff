+def test_descartar_importe_cero_elimina_la_venta_vacia(con, tabla_cruda):
+    """Una venta de cero euros no es una venta: no cambia el total pero infla el recuento."""
+    origen = tabla_cruda(
+        [
+            VENTA,
+            ("2", "15/03/2026", "Madrid", "Teclado", "1", "0.00"),
+            ("3", "15/03/2026", "Madrid", "Teclado", "1", "0,00"),
+        ]
+    )
+    limpiar.convertir_tipos(con, origen, "tipos")
+
+    recuento = limpiar.descartar_importe_cero(con, "tipos", "salida")
+
+    assert recuento.entrantes == 3
+    assert recuento.salientes == 1
+    assert con.sql("SELECT id_venta FROM salida").fetchall() == [(1,)]
+
+
+def test_descartar_importe_cero_conserva_los_negativos(con, tabla_cruda):
