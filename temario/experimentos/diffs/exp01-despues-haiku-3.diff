+def descartar_importes_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Descarta las ventas con importe exactamente cero.
+
+    Una venta sin importe es una transacción fantasma: no tiene valor de negocio.
+    Se descarta sin ambigüedad, no se imputa.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"""
+        CREATE OR REPLACE TABLE {destino} AS
+        SELECT * FROM {origen}
+        WHERE importe != 0
+        """
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importes_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe exactamente cero",
+    )
+
+
