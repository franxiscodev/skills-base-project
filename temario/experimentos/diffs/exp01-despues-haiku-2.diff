+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Descarta ventas con importe cero.
+
+    Un importe de cero indica que no hay movimiento de dinero. No es una venta
+    válida y no debe contabilizarse en la facturación.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"""
+        CREATE OR REPLACE TABLE {destino} AS
+        SELECT * FROM {origen}
+        WHERE importe > 0
+        """
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe cero",
+    )
+
