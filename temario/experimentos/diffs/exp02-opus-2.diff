+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Descarta las ventas cuyo importe es exactamente cero.
+
+    Una fila con importe 0 no es una venta: no aporta al total y ensucia el
+    recuento de operaciones y cualquier media por ciudad o producto. El sistema de
+    origen las emite como resto de operaciones anuladas o de líneas de albarán que
+    nunca se facturaron.
+
+    El criterio es **el cero exacto, y nada más**. En particular:
+
+    - **Los negativos se quedan.** Un importe negativo es un abono, el reverso de
+      una venta real, y tiene que restar del total. Ensanchar esto a `<= 0` haría
+      desaparecer las devoluciones sin que salte nada: el total subiría y el
+      informe seguiría cuadrando consigo mismo.
+    - **Sin umbral.** Una venta de un céntimo es pequeña, no inexistente. Decidir a
+      partir de qué cifra algo "no cuenta" es una decisión de negocio que no le
+      corresponde al pipeline.
+
+    Va después de `convertir_tipos` porque compara contra un número: antes, el
+    importe todavía es el texto del CSV y `'0,00'` no se parece a cero.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"CREATE OR REPLACE TABLE {destino} AS SELECT * FROM {origen} WHERE importe <> 0"
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe exactamente cero (los negativos se conservan)",
+    )
+
+
 def imputar_ciudad(
