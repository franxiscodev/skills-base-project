+def test_descartar_importe_cero_conserva_lo_que_roza_el_limite(con, tabla_cruda):
+    """Las dos filas pegadas al cero por el lado que se queda.
+
+    El abono (importe negativo) cae si alguien escribe `<= 0`; el céntimo cae si
+    alguien mete un umbral del tipo `abs(importe) < 1`. Son los dos ensanchamientos
+    plausibles del criterio, y ninguno haría fallar ningún otro test del archivo.
+    """
+    origen = tabla_cruda(
+        [
+            ("1", "15/03/2026", "Madrid", "Teclado", "-1", "-29.90"),
+            ("2", "15/03/2026", "Madrid", "Ratón", "1", "0.01"),
+        ]
+    )
+    limpiar.convertir_tipos(con, origen, "tipos")
+
+    recuento = limpiar.descartar_importe_cero(con, "tipos", "salida")
+
+    assert recuento.descartadas == 0
+    importes = con.sql("SELECT importe FROM salida ORDER BY id_venta").fetchall()
+    assert importes == [(-29.90,), (0.01,)]
+
