+def test_descartar_importe_cero_elimina_ventas_sin_importe(con, tabla_cruda):
+    """Una venta con importe cero no aporta nada a la facturación."""
+    origen = tabla_cruda([VENTA, ("2", "15/03/2026", "Madrid", "Teclado", "1", "0.00")])
+    limpiar.normalizar_texto(con, origen, "texto")
+    limpiar.convertir_tipos(con, "texto", "tipos")
+    limpiar.imputar_ciudad(con, "tipos", "ciudad")
+
+    recuento = limpiar.descartar_importe_cero(con, "ciudad", "salida")
+
+    assert recuento.entrantes == 2
+    assert recuento.salientes == 1
+    assert recuento.descartadas == 1
+
+
+def test_descartar_importe_cero_no_descarta_venta_con_importe(con, tabla_cruda):
+    """Una venta con importe válido, por pequeño que sea, se mantiene."""
+    origen = tabla_cruda([("1", "15/03/2026", "Madrid", "Teclado", "1", "0.01")])
+    limpiar.normalizar_texto(con, origen, "texto")
+    limpiar.convertir_tipos(con, "texto", "tipos")
+    limpiar.imputar_ciudad(con, "tipos", "ciudad")
+
+    recuento = limpiar.descartar_importe_cero(con, "ciudad", "salida")
+
+    assert recuento.descartadas == 0
+    assert con.sql("SELECT importe FROM salida").fetchone()[0] == 0.01
+
