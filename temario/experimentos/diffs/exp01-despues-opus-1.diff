+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Descarta las ventas de importe cero: **no son una venta, son un apunte.**
+
+    El criterio, por contraste con `imputar_ciudad`: allí el importe es real y hay
+    que conservarlo aunque falte el resto. Aquí no hay importe que conservar, así
+    que la fila no aporta nada al total y sí ensucia los promedios y los recuentos
+    por ciudad y producto.
+
+    Solo el cero exacto. Un **importe negativo se conserva**: es el abono de una
+    devolución y tiene que restar del neto —quitarlo inflaría la facturación, que es
+    justo lo que `marcar_devoluciones` evita más adelante.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"CREATE OR REPLACE TABLE {destino} AS SELECT * FROM {origen} WHERE importe <> 0"
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe cero: no hay venta que contar",
+    )
+
+
