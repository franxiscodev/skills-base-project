+def test_descartar_importe_cero_conserva_el_importe_negativo(con, tabla_cruda):
+    """El abono de una devolución tiene importe negativo y debe restar del neto.
+
+    Está pegado al límite de la regla por el otro lado: si mañana el criterio pasa
+    de `<> 0` a `> 0`, la facturación sube sola y ningún otro test se entera.
+    """
+    origen = tabla_cruda(
+        [
+            ("1", "15/03/2026", "Madrid", "Teclado", "-1", "-29.90"),
+            ("2", "15/03/2026", "Madrid", "Ratón", "1", "0,01"),
+        ]
+    )
+    limpiar.convertir_tipos(con, origen, "tipos")
+
+    recuento = limpiar.descartar_importe_cero(con, "tipos", "salida")
+
+    assert recuento.descartadas == 0
+    importes = con.sql("SELECT importe FROM salida ORDER BY id_venta").fetchall()
+    assert importes == [(-29.90,), (0.01,)]
+
