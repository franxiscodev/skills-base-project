+def test_descartar_importe_cero_elimina_la_fila(con, tabla_cruda):
+    """Un importe a cero no es una venta: no aporta facturación y falsea promedios."""
+    origen = tabla_cruda(
+        [
+            VENTA,
+            ("2", "15/03/2026", "Madrid", "Teclado", "1", "0"),
+            ("3", "15/03/2026", "Madrid", "Teclado", "1", "0,00"),
+        ]
+    )
+    limpiar.convertir_tipos(con, origen, "tipos")
+
+    recuento = limpiar.descartar_importe_cero(con, "tipos", "salida")
+
+    assert recuento.entrantes == 3
+    assert recuento.salientes == 1
+    assert recuento.descartadas == 2
+
+
+def test_descartar_importe_cero_respeta_las_devoluciones(con, tabla_cruda):
+    """Una devolución tiene importe real: no es una venta a cero."""
