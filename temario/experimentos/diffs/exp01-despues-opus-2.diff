+def descartar_importe_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Elimina las ventas con importe exactamente cero.
+
+    Un importe a cero no es una venta: es un artefacto del sistema de origen —una
+    línea de regalo, un ajuste técnico, una fila abierta y nunca cerrada—. Sumarlo
+    no cambia la facturación, pero **sí infla el recuento de ventas** y desvirtúa
+    cualquier media por ciudad o por producto.
+
+    Se descarta y no se marca, a diferencia de `marcar_devoluciones`: una devolución
+    es un hecho de negocio que alguien querrá leer; un importe a cero no aporta nada
+    al informe salvo ruido.
+
+    Va **después de `convertir_tipos`** porque compara contra un número, no contra
+    texto: `"0,00"`, `"0.00"` y `"0"` son cadenas distintas y el mismo importe. Por
+    eso también asume que ya no quedan importes a NULL.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"""
+        CREATE OR REPLACE TABLE {destino} AS
+        SELECT * FROM {origen} WHERE importe <> 0
+        """
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importe_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe cero: no es una venta",
+    )
+
+
