+def test_descartar_importe_cero_conserva_las_devoluciones(con, tabla_cruda):
+    """Una devolución tiene importe distinto de cero: no es un artefacto.
+
+    Es la fila que queda justo al lado del criterio y fuera de él. Si mañana alguien
+    amplía la regla a `importe <= 0`, las devoluciones desaparecen del informe y el
+    total de devoluciones pasa a ser cero sin que nada avise.
+    """
+    origen = tabla_cruda(
+        [
+            VENTA,
+            ("2", "15/03/2026", "Madrid", "Teclado", "-1", "-29.90"),
+            ("3", "15/03/2026", "Madrid", "Teclado", "-1", "29.90"),
+        ]
+    )
+    limpiar.convertir_tipos(con, origen, "tipos")
+
+    recuento = limpiar.descartar_importe_cero(con, "tipos", "salida")
+
+    assert recuento.descartadas == 0
+    ids = con.sql("SELECT id_venta FROM salida ORDER BY id_venta").fetchall()
+    assert ids == [(1,), (2,), (3,)]
