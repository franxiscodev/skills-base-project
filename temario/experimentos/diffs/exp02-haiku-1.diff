+def descartar_importes_cero(
+    con: duckdb.DuckDBPyConnection, origen: str, destino: str
+) -> Recuento:
+    """Descarta las ventas con importe cero.
+
+    Una venta sin importe es un registro fantasma que no representa dinero en movimiento.
+    No se imputa como se hace con la ciudad: la facturación de una venta cero es cero,
+    y no debería ocupar espacio en un informe de análisis de ventas.
+    """
+    antes = _contar(con, origen)
+    con.execute(
+        f"""
+        CREATE OR REPLACE TABLE {destino} AS
+        SELECT * FROM {origen}
+        WHERE importe > 0
+        """
+    )
+    despues = _contar(con, destino)
+
+    return Recuento(
+        paso="descartar_importes_cero",
+        entrantes=antes,
+        salientes=despues,
+        motivo="importe cero",
+    )
+
